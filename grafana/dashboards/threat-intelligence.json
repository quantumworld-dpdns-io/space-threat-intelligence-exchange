{
  "dashboard": {
    "title": "Space Threat Intelligence Exchange",
    "tags": ["stie", "security", "threat-intel"],
    "timezone": "browser",
    "panels": [
      {
        "title": "API Request Rate",
        "type": "graph",
        "targets": [
          {"expr": "rate(http_requests_total[5m])", "legendFormat": "{{method}} {{endpoint}}"}
        ]
      },
      {
        "title": "Threat Reports by Severity",
        "type": "piechart",
        "targets": [
          {"expr": "count(threat_reports_total) by (severity)", "legendFormat": "{{severity}}"}
        ]
      },
      {
        "title": "P2P Network Peers",
        "type": "stat",
        "targets": [
          {"expr": "p2p_connected_peers"}
        ]
      },
      {
        "title": "Active Threat Types",
        "type": "bargauge",
        "targets": [
          {"expr": "count(threat_reports_total) by (threat_type)", "legendFormat": "{{threat_type}}"}
        ]
      },
      {
        "title": "Database Connections",
        "type": "graph",
        "targets": [
          {"expr": "pg_stat_database_numbackends", "legendFormat": "{{datname}}"}
        ]
      },
      {
        "title": "API Response Latency (p99)",
        "type": "graph",
        "targets": [
          {"expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p99"}
        ]
      }
    ]
  }
}
