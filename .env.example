# Space Threat Intelligence Exchange - Environment Configuration

# Application
APP_NAME=space-threat-intelligence-exchange
APP_VERSION=0.1.0
APP_DEBUG=false
APP_SECRET_KEY=change-me-in-production
APP_API_PREFIX=/api/v1
APP_CORS_ORIGINS=["*"]

# Database
DATABASE_URL=postgresql+asyncpg://stie:stie@localhost:5432/stie
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Qdrant (Vector Database)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=threat_reports

# Chroma (Alternative Vector DB)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=threat_reports

# DuckDB (Local Analytics)
DUCKDB_PATH=data/analytics.duckdb

# Iceberg (Lakehouse)
ICEBERG_WAREHOUSE=/data/iceberg
ICEBERG_CATALOG_URI=http://localhost:8181

# P2P Network
P2P_ENABLED=true
P2P_PORT=9001
P2P_BOOTSTRAP_PEERS=["/ip4/0.0.0.0/tcp/9001/p2p/"]
P2P_PRIVATE_KEY=
P2P_LISTEN_ADDRESSES=["/ip4/0.0.0.0/tcp/9001"]

# AI / LLM
AI_LLM_PROVIDER=ollama
AI_LLM_MODEL=gemma3
AI_LLM_API_URL=http://localhost:11434
AI_LLM_API_KEY=
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_DIMENSION=768

# W&B Weave
WANDB_API_KEY=
WANDB_PROJECT=stie-threat-intelligence
WEAVE_ENABLED=false

# Authentication
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EXPIRATION_MINUTES=60
AUTH_JWT_REFRESH_EXPIRATION_DAYS=7

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_JSON_INDENT=0

# Monitoring
METRICS_ENABLED=true
OPENTELEMETRY_ENABLED=false
OPENTELEMETRY_ENDPOINT=http://localhost:4318
